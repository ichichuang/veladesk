    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.134",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.96",
    "@iconify-json/tabler": "1.2.38",
    "@iconify/utils": "3.1.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
